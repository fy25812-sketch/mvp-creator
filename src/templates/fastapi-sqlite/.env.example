# {{PROJECT_NAME}} — environment template (rendered {{GENERATED_AT}})
#
# Copy to .env and adjust:      cp .env.example .env
# docker-compose.yml reads this file via `env_file`, so the same values drive
# both local development and the deployed container.

# ---- application -----------------------------------------------------------
PROJECT_NAME="{{PROJECT_NAME}}"
APP_TITLE="{{APP_TITLE}}"
APP_VERSION=0.1.0

# Business entity shown in the server-rendered UI (singular, lowercase).
PRIMARY_ENTITY="{{PRIMARY_ENTITY}}"

# ---- server ----------------------------------------------------------------
# Host port published by docker compose. It is bound to 127.0.0.1 only; host
# nginx terminates TLS and proxies to it. See deploy/nginx.conf.
APP_PORT={{APP_PORT}}

# Inside the container the app always listens on 8000 (see Dockerfile CMD).
LOG_LEVEL=info
